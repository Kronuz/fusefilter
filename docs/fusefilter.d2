# fusefilter: a key's hash picks one 8-bit slot in each of three consecutive segments; their XOR is its fingerprint.
# Render: d2 docs/fusefilter.d2 docs/fusefilter.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

# Three columns of three cells, filled column by column: the key, the slots, the check.
grid-columns: 3
horizontal-gap: 80
vertical-gap: 90

g1: "" {style.opacity: 0}
key: "hash of the key" {shape: oval}
g2: "" {style.opacity: 0}

a: "slot a\nin segment i"
b: "slot b\nin segment i+1"
c: "slot c\nin segment i+2"

g3: "" {style.opacity: 0}
check: "a ⊕ b ⊕ c == 8-bit fingerprint?\nyes: maybe present\nno: absent" {
  shape: page
  style.fill: "#F4F1EA"
}
g4: "" {style.opacity: 0}

key -> a
key -> b
key -> c
a -> check
b -> check
c -> check
